{
  "name": "KaijTab 新标签页",
  "short_name": "KaijTab",
  "description": "自由画布式新标签页：本地动态壁纸、模块按需加载、零服务端。",
  "start_url": "./main.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "icons": [
    { "src": "./icons/icon32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "./icons/icon128.png", "sizes": "128x128", "type": "image/png" },
    { "src": "./icons/icon192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icons/icon512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
