{
  "manifest_version": 3,
  "name": "KaijTab",
  "version": "0.6.4",
  "description": "自由画布式新标签页：本地动态壁纸、模块按需加载、零服务端。",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开 KaijTab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "main.html"
  },
  "permissions": ["storage", "unlimitedStorage", "favicon", "bookmarks", "history"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://top.baidu.com/*",
    "https://www.toutiao.com/*",
    "https://app.bilibili.com/*",
    "https://api.juejin.cn/*",
    "https://api.github.com/*",
    "https://de1.api.radio-browser.info/*",
    "https://all.api.radio-browser.info/*",
    "https://www.baidu.com/*",
    "https://api.bing.com/*",
    "https://suggestqueries.google.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
