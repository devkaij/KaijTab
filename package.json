{
  "name": "kaijtab",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "description": "自由画布式新标签页：本地动态壁纸、模块按需加载、零服务端。",
  "scripts": {
    "dev": "vite build --watch",
